{
  "manifest_version": 3,
  "name": "Craxle Autofill",
  "version": "1.0.0",
  "description": "Fills your details into a job application form you already opened. It never submits anything for you.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://craxle.com/*",
    "https://www.craxle.com/*",
    "https://vidyapath-athlyx-38f1.up.railway.app/*",
    "https://vidyapath-athlyx-a3b5.up.railway.app/*"
  ],
  "action": {
    "default_title": "Craxle Autofill",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
